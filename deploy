#!/usr/bin/env bash
# Build this checkout and atomically publish its Python package, C ABI, and headers.
set -euo pipefail
cd "$(dirname "$0")"

python_bin=${PYTHON:-python3}
build_dir=${LEMMAKERNEL_BUILD_DIR:-build}
dest=${LEMMAKERNEL_DEPLOY_ROOT:-/srv/pi/lemmakernel}

"$python_bin" tools/manifest.py check
if command -v cmake >/dev/null && command -v ninja >/dev/null; then
  cmake -S . -B "$build_dir" -G Ninja \
    -DLEMMAKERNEL_MARCH="${LEMMAKERNEL_MARCH:-native}"
  ninja -C "$build_dir"
elif command -v docker >/dev/null; then
  docker build --file tools/deploy.Dockerfile \
    --tag lemmakernel-builder:bookworm tools
  docker run --rm --user "$(id -u):$(id -g)" \
    --env HOME=/tmp --env LEMMAKERNEL_MARCH="${LEMMAKERNEL_MARCH:-native}" \
    --volume "$PWD:/src" --workdir /src lemmakernel-builder:bookworm \
    sh -eu -c '
      cmake -S . -B "$1" -G Ninja -DLEMMAKERNEL_MARCH="$LEMMAKERNEL_MARCH"
      ninja -C "$1"
      rm -rf "$1/runtime-libs"
      mkdir -p "$1/runtime-libs"
      ldd "$1/liblemmakernel.so" |
        while read -r soname _arrow dependency _rest; do
          case "$soname" in
            libnauty*) cp -L "$dependency" "$1/runtime-libs/$soname" ;;
          esac
        done
    ' sh "$build_dir"
else
  echo "deploy: either cmake and ninja, or docker, must be installed" >&2
  exit 1
fi

library="$build_dir/liblemmakernel.so"
[[ -f $library ]] || { echo "deploy: $library was not built" >&2; exit 1; }

commit=$(git rev-parse HEAD)
[[ -z $(git status --porcelain) ]] || commit="$commit-dirty"
if [[ ! -d $dest ]]; then
  sudo -n install -d -o "$(id -un)" -g "$(id -gn)" -m 755 "$dest"
fi
[[ -w $dest ]] || { echo "deploy: $dest is not writable" >&2; exit 1; }

version="$dest/$commit"
stage="$dest/.stage.$$"
trap 'rm -rf "$stage"' EXIT
rm -rf "$stage"
mkdir -p "$stage/python/lemmakernel" "$stage/lib" "$stage/include"
rsync -a --exclude __pycache__ python/lemmakernel/ "$stage/python/lemmakernel/"
cp "$library" "$stage/python/lemmakernel/liblemmakernel.so"
ln -s ../python/lemmakernel/liblemmakernel.so "$stage/lib/liblemmakernel.so"
while read -r soname _arrow dependency _rest; do
  case "$soname" in
    libnauty*) ;;
    *) continue ;;
  esac
  if [[ $dependency == not ]]; then
    dependency="$build_dir/runtime-libs/$soname"
  fi
  [[ -f $dependency ]] || {
    echo "deploy: cannot resolve $soname for $library" >&2
    exit 1
  }
  cp -L "$dependency" "$stage/python/lemmakernel/$soname"
  ln -s "../python/lemmakernel/$soname" "$stage/lib/$soname"
done < <(ldd "$library")
cp -a runtime/include/lemmakernel "$stage/include/"
cp README.md BENCHMARKS.md LICENSE "$stage/"
printf '%s\n' "$commit" > "$stage/COMMIT"
chmod -R a+rX,ug+w "$stage"
rm -rf "$version"
mv "$stage" "$version"

ln -sfn "$commit" "$dest/.current.$$"
mv -T "$dest/.current.$$" "$dest/current"

find "$dest" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' |
  sort -rn | tail -n +3 | cut -d' ' -f2- |
  while read -r old; do rm -rf "$old"; done

smoke='import lemmakernel as lk; c=lk.Context(); f=c.explicit(lk.matrix(2, [[[1, 0], [0, 1]]])); assert c.value("gfp.rank", f).values == [2]; assert any(m["module"]["name"] == "circuit_fires" for m in lk.describe()["modules"])'
PYTHONPATH="$version/python${PYTHONPATH:+:$PYTHONPATH}" LEMMAKERNEL_LIB='' \
  "$python_bin" -c "$smoke"

if ! env -u PYTHONPATH -u LEMMAKERNEL_LIB \
    LEMMAKERNEL_DEPLOY_ROOT="$dest" "$python_bin" - <<'PY'
import os
from pathlib import Path
import lemmakernel

root = Path(os.environ["LEMMAKERNEL_DEPLOY_ROOT"]).resolve()
assert Path(lemmakernel.__file__).resolve().is_relative_to(root)
PY
then
  user_site=$("$python_bin" -m site --user-site)
  mkdir -p "$user_site"
  printf '%s\n' "$dest/current/python" > "$user_site/lemmakernel.pth.tmp"
  mv "$user_site/lemmakernel.pth.tmp" "$user_site/lemmakernel.pth"
fi
env -u PYTHONPATH -u LEMMAKERNEL_LIB "$python_bin" -c "$smoke"

echo "LemmaKernel $commit published to $dest"
